# Auto-detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# Explicit text files
*.py text eol=lf diff=python
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pt binary
*.pth binary
*.h5 binary
*.keras binary
*.joblib binary
*.pkl binary
